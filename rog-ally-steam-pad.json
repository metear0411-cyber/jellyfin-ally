// ROG Ally under Steam Input shows up as "Microsoft X-Box 360 pad 0" (SDL joystick, 11 buttons, 6 axes).
// Button numbers follow the Linux xpad order.
{
  "name": "ROG Ally (Steam virtual X-Box 360 pad)",
  "idmatcher": "X-Box 360",
  "mapping":
  {
    // A
    "KEY_BUTTON_0": "enter",

    // B
    "KEY_BUTTON_1": {
      "short": "back",
      "long": "home"
    },

    // X
    "KEY_BUTTON_2": "cycle_audio",

    // Y
    "KEY_BUTTON_3": "search",

    // LB / RB
    "KEY_BUTTON_4": "seek_backward",
    "KEY_BUTTON_5": "seek_forward",

    // View (back) / Menu (start)
    "KEY_BUTTON_6": "cycle_subtitles",
    "KEY_BUTTON_7": "home",

    // left / right stick press
    "KEY_BUTTON_9": "",
    "KEY_BUTTON_10": "host:fullscreen",

    // D-pad (hat)
    "KEY_HAT_DOWN": "down",
    "KEY_HAT_UP": "up",
    "KEY_HAT_RIGHT": "right",
    "KEY_HAT_LEFT": "left",

    // left stick
    "KEY_AXIS_0_UP": "left",
    "KEY_AXIS_0_DOWN": "right",
    "KEY_AXIS_1_UP": "up",
    "KEY_AXIS_1_DOWN": "down",

    // right stick vertical = volume
    "KEY_AXIS_4_UP": "increase_volume",
    "KEY_AXIS_4_DOWN": "decrease_volume"
  }
}
